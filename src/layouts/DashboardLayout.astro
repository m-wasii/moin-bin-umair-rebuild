---
import { siteOrigin } from "../lib/hosts";
import {
	listPhotoCategories,
	listPhotos,
	listVideos,
} from "../lib/store";

interface Props {
	title: string;
	section: "videos" | "photos" | "trash";
}

const { title, section } = Astro.props;
const siteHref = siteOrigin(Astro.url);

const [videos, photos, categories] = await Promise.all([
	listVideos({ includeDeleted: true }),
	listPhotos({ includeDeleted: true }),
	listPhotoCategories({ includeDeleted: true }),
]);

const trashCount =
	videos.filter((video) => video.deletedAt).length +
	categories.filter((category) => category.deletedAt).length +
	photos.filter((photo) => photo.deletedAt && !photo.trashedWithCategory)
		.length;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#050505" />
		<title>{title} — MBU Dashboard</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" href="/dashboard.css" />
	</head>
	<body class="dash">
		<header class="dash-bar">
			<p class="dash-bar__brand">MBU</p>
			<nav class="dash-bar__nav" aria-label="Dashboard">
				<a
					href="/dashboard"
					aria-current={section === "videos" ? "page" : undefined}>Videos</a
				>
				<a
					href="/dashboard/photos"
					aria-current={section === "photos" ? "page" : undefined}>Photos</a
				>
				<a
					href="/dashboard/trash"
					aria-current={section === "trash" ? "page" : undefined}
					>Trash{trashCount > 0 ? ` (${trashCount})` : ""}</a
				>
			</nav>
			<a class="dash-bar__site" href={siteHref}>View site</a>
		</header>
		<main class="dash-main">
			<slot />
		</main>
	</body>
</html>
