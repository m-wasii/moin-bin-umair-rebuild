---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
	title?: string;
	description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonicalUrl = Astro.site?.toString();
const ogImage = Astro.site
	? new URL("/media/hero-poster.webp", Astro.site).href
	: "/media/hero-poster.webp";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: site.name,
	jobTitle: "Filmmaker",
	url: canonicalUrl,
	sameAs: [site.vimeoUrl],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b1520" />
		<meta name="color-scheme" content="dark" />

		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://i.vimeocdn.com" crossorigin />
		<link rel="preconnect" href="https://player.vimeo.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Outfit:wght@400;500;600&display=swap"
		/>

		<title>{title}</title>
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(structuredData)}
		/>
	</head>
	<body>
		<a class="skip-link" href="#commercial">Skip to selected work</a>
		<slot />
		<script src="../scripts/site.ts"></script>
	</body>
</html>
