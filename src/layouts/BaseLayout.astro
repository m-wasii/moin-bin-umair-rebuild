---
import "../styles/global.css";
import { site } from "../data/site";
import {
	defaultLang,
	LANG_SCROLL_KEY,
	localizedHomePath,
	PREFERRED_LANG_KEY,
	useTranslations,
	type Lang,
} from "../i18n/ui";
import { heroMediaSrc, heroMediaVersion } from "../lib/store";
import {
	buildResponsiveImageAttrs,
	cfImageResizingAvailable,
	RESPONSIVE_WIDTHS,
} from "../lib/responsive-image";
import { isPreviewHost } from "../lib/hosts";

interface Props {
	lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const title = t("meta.title");
const description = t("meta.description");

const enPath = localizedHomePath("en");
const dePath = localizedHomePath("de");
const canonicalPath = localizedHomePath(lang);
const siteOrigin =
	Astro.site ?? new URL("https://moinbinumair.com");
const canonicalUrl = new URL(canonicalPath, siteOrigin).href;
const enUrl = new URL(enPath, siteOrigin).href;
const deUrl = new URL(dePath, siteOrigin).href;
const heroVersion = await heroMediaVersion();
const ogImagePath = heroMediaSrc("hero-poster.webp", heroVersion);
const ogImage = new URL(ogImagePath, siteOrigin).href;
const cfImages = cfImageResizingAvailable(Astro.url.hostname);
const isPreview = isPreviewHost(Astro.url.hostname);
const heroPosterAttrs = buildResponsiveImageAttrs({
	src: ogImagePath,
	widths: RESPONSIVE_WIDTHS.hero,
	sizes: "100vw",
	width: 1920,
	height: 1080,
	loading: "eager",
	fetchpriority: "high",
	cfImages,
});
const heroPosterPreload = heroPosterAttrs.src;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: site.name,
	jobTitle: t("meta.jobTitle"),
	url: canonicalUrl,
	sameAs: [site.instagramUrl, site.linkedinUrl, site.vimeoUrl],
};
---

<!doctype html>
<html lang={lang} data-cf-images={cfImages ? "1" : "0"}>
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#050a12" />
		<meta name="color-scheme" content="dark" />
		{isPreview && <meta name="robots" content="noindex, nofollow" />}

		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="de" href={deUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="preload"
			as="image"
			href={heroPosterPreload}
			type="image/webp"
			fetchpriority="high"
			imagesizes="100vw"
			{...(heroPosterAttrs.srcset
				? { imagesrcset: heroPosterAttrs.srcset }
				: {})}
		/>
		<link rel="preconnect" href="https://i.vimeocdn.com" crossorigin />
		<link rel="preconnect" href="https://player.vimeo.com" crossorigin />
		<link rel="preconnect" href="https://i.ytimg.com" crossorigin />
		<link
			rel="preconnect"
			href="https://www.youtube-nocookie.com"
			crossorigin
		/>

		<title>{title}</title>
		<script
			is:inline
			define:vars={{ PREFERRED_LANG_KEY, LANG_SCROLL_KEY, enPath, dePath, lang }}
		>
			document.documentElement.classList.add("js");
			/* Pre-paint compact only where the pill almost never fits; site.ts
			   refines with real brand/nav/lang measurements after layout. */
			(function () {
				try {
					if (window.innerWidth < 1200) {
						document.documentElement.classList.add("nav-is-compact");
					}
				} catch (e) {}
			})();
			/* Restore scroll after language switch without smooth top→section jump. */
			(function () {
				try {
					var raw = sessionStorage.getItem(LANG_SCROLL_KEY);
					if (raw == null) return;
					sessionStorage.removeItem(LANG_SCROLL_KEY);

					var y = 0;
					var hash = "";
					if (raw.charAt(0) === "{") {
						var parsed = JSON.parse(raw);
						y = parseInt(parsed && parsed.y, 10);
						hash = (parsed && parsed.hash) || "";
					} else {
						y = parseInt(raw, 10);
					}
					if (!isFinite(y) || y < 0) y = 0;

					document.documentElement.classList.add("scroll-instant");
					if ("scrollRestoration" in history) {
						history.scrollRestoration = "manual";
					}

					var restore = function () {
						window.scrollTo(0, y);
					};

					restore();
					document.addEventListener("DOMContentLoaded", restore);
					window.addEventListener("load", function () {
						restore();
						if (hash && hash.charAt(0) === "#") {
							try {
								history.replaceState(
									null,
									"",
									location.pathname + location.search + hash,
								);
							} catch (e) {}
						}
						requestAnimationFrame(function () {
							restore();
							document.documentElement.classList.remove("scroll-instant");
						});
					});
				} catch (e) {}
			})();
			(function () {
				try {
					var stored = localStorage.getItem(PREFERRED_LANG_KEY);
					var target = null;

					if (stored === "en" || stored === "de") {
						target = stored === "de" ? dePath : enPath;
					} else {
						var languages = navigator.languages && navigator.languages.length
							? Array.from(navigator.languages)
							: [navigator.language || ""];
						var prefersDe = false;
						for (var i = 0; i < languages.length; i++) {
							var code = String(languages[i] || "").toLowerCase();
							if (code.startsWith("de")) {
								prefersDe = true;
								break;
							}
							if (code.startsWith("en")) {
								break;
							}
						}
						if (prefersDe && lang !== "de") {
							target = dePath;
						}
					}

					if (!target) return;

					var current = location.pathname;
					if (!current.endsWith("/")) current += "/";
					var normalizedTarget = target.endsWith("/") ? target : target + "/";
					if (current === normalizedTarget || current === target) return;

					location.replace(target + location.search + location.hash);
				} catch (e) {}
			})();
		</script>
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(structuredData)}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">{t("a11y.skip")}</a>
		<slot />
		<script src="../scripts/site-bootstrap.ts"></script>
		{/* Defer shorts player until idle / near viewport / interaction.
		    First tap on a short awaits the chunk, then opens via openFileShort
		    so the click cannot race the module's own capture listener. */}
		<script>
			type ShortsPlayerModule = typeof import("../scripts/shorts-player.ts");

			let shortsPlayerPromise: Promise<ShortsPlayerModule> | null = null;
			let shortsPlayerMod: ShortsPlayerModule | null = null;

			function loadShortsPlayer() {
				if (!shortsPlayerPromise) {
					shortsPlayerPromise = import("../scripts/shorts-player.ts").then(
						(mod) => {
							shortsPlayerMod = mod;
							return mod;
						},
					);
				}
				return shortsPlayerPromise;
			}

			const ric = window.requestIdleCallback?.bind(window);
			if (ric) ric(() => loadShortsPlayer(), { timeout: 2500 });
			else window.setTimeout(loadShortsPlayer, 1200);

			window.addEventListener("pointerdown", loadShortsPlayer, {
				once: true,
				passive: true,
				capture: true,
			});
			window.addEventListener("keydown", loadShortsPlayer, { once: true });

			const shortsRoot = document.getElementById("shorts");
			if (shortsRoot && "IntersectionObserver" in window) {
				const obs = new IntersectionObserver(
					(entries) => {
						if (!entries.some((entry) => entry.isIntersecting)) return;
						loadShortsPlayer();
						obs.disconnect();
					},
					{ rootMargin: "240px 0px" },
				);
				obs.observe(shortsRoot);
			}

			/* Cold path: chunk not evaluated yet — hold the click, then open. */
			document.addEventListener(
				"click",
				(event) => {
					if (shortsPlayerMod) return;
					const target = event.target;
					if (!(target instanceof Element)) return;
					const link = target.closest<HTMLElement>("[data-video]");
					if (!link || link.dataset.videoProvider !== "file") return;

					event.preventDefault();
					event.stopImmediatePropagation();

					void loadShortsPlayer().then((mod) => {
						mod.openFileShort(link);
					});
				},
				true,
			);
		</script>
	</body>
</html>
