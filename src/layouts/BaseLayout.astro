---
import "../styles/global.css";
import { site } from "../data/site";
import {
	defaultLang,
	localizedHomePath,
	PREFERRED_LANG_KEY,
	useTranslations,
	type Lang,
} from "../i18n/ui";

interface Props {
	lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const title = t("meta.title");
const description = t("meta.description");

const enPath = localizedHomePath("en");
const dePath = localizedHomePath("de");
const canonicalPath = localizedHomePath(lang);
const canonicalUrl = Astro.site
	? new URL(canonicalPath, Astro.site).href
	: undefined;
const enUrl = Astro.site ? new URL(enPath, Astro.site).href : enPath;
const deUrl = Astro.site ? new URL(dePath, Astro.site).href : dePath;
const ogImage = Astro.site
	? new URL("/media/hero-poster.webp", Astro.site).href
	: "/media/hero-poster.webp";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: site.name,
	jobTitle: t("meta.jobTitle"),
	url: canonicalUrl,
	sameAs: [site.vimeoUrl, site.instagramUrl],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#d97706" />
		<meta name="color-scheme" content="dark" />

		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="de" href={deUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Outfit:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="preconnect" href="https://i.vimeocdn.com" crossorigin />
		<link rel="preconnect" href="https://player.vimeo.com" crossorigin />
		<link rel="preconnect" href="https://i.ytimg.com" crossorigin />
		<link
			rel="preconnect"
			href="https://www.youtube-nocookie.com"
			crossorigin
		/>

		<title>{title}</title>
		<script is:inline define:vars={{ PREFERRED_LANG_KEY, enPath, dePath, lang }}
		>
			document.documentElement.classList.add("js");
			(function () {
				try {
					var stored = localStorage.getItem(PREFERRED_LANG_KEY);
					var target = null;

					if (stored === "en" || stored === "de") {
						target = stored === "de" ? dePath : enPath;
					} else {
						var languages =
							navigator.languages && navigator.languages.length
								? Array.from(navigator.languages)
								: [navigator.language || ""];
						var prefersDe = false;
						for (var i = 0; i < languages.length; i++) {
							var code = String(languages[i] || "").toLowerCase();
							if (code.startsWith("de")) {
								prefersDe = true;
								break;
							}
							if (code.startsWith("en")) {
								break;
							}
						}
						if (prefersDe && lang !== "de") {
							target = dePath;
						}
					}

					if (!target) return;

					var current = location.pathname;
					if (!current.endsWith("/")) current += "/";
					var normalizedTarget = target.endsWith("/") ? target : target + "/";
					if (current === normalizedTarget || current === target) return;

					location.replace(target + location.search + location.hash);
				} catch (e) {}
			})();
		</script>
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(structuredData)}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">{t("a11y.skip")}</a>
		<slot />
		<script src="../scripts/site.ts"></script>
	</body>
</html>
