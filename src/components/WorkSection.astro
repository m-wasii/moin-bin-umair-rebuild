---
import type { Project } from "../data/projects";
import { mosaicSpans } from "../lib/mosaic";
import { useTranslations, type Lang } from "../i18n/ui";
import ProjectCard from "./ProjectCard.astro";

interface Props {
	id: "commercial" | "art" | "shorts";
	number: string;
	title: string;
	description: string;
	projects: Project[];
	lang: Lang;
}

const { id, number, title, description, projects, lang } = Astro.props;
const t = useTranslations(lang);

const metaLabel =
	projects.length === 0
		? t("section.meta.vertical")
		: `${projects.length} ${
				projects.length === 1
					? t("section.meta.project")
					: t("section.meta.projects")
			}`;
const isReel = id === "shorts";
const spans = isReel ? [] : mosaicSpans(projects.length);
---

<section
	class:list={[
		"work-section",
		`work-section--${id}`,
		{ "work-section--shorts": id === "shorts" },
	]}
	id={id}
	aria-labelledby={`${id}-title`}
	data-nav-section
>
	<header class="section-heading" data-reveal>
		<p class="section-heading__ghost" aria-hidden="true">{number}</p>
		<div class="section-heading__meta">
			<p>{number}</p>
			<p>{metaLabel}</p>
		</div>
		<h2 id={`${id}-title`}>{title}</h2>
		<p class="section-heading__description">{description}</p>
	</header>

	{
		projects.length > 0 ? (
			<div
				class:list={["project-grid", { "project-grid--reel": id === "shorts" }]}
			>
				{projects.map((project, index) => (
					<ProjectCard
						project={project}
						lang={lang}
						index={index}
						span={spans[index]}
					/>
				))}
			</div>
		) : (
			<p class="work-section__empty" data-reveal>
				{t("section.shorts.empty")}
			</p>
		)
	}
</section>
