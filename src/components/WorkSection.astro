---
import type { Project } from "../data/projects";
import { mosaicRowSizes, mosaicSpans } from "../lib/mosaic";
import { useTranslations, type Lang, type UiKey } from "../i18n/ui";
import ProjectCard from "./ProjectCard.astro";

interface Props {
	id: "indie" | "local" | "bts" | "shorts";
	number: string;
	title: string;
	description: string;
	projects: Project[];
	lang: Lang;
}

const { id, number, title, description, projects, lang } = Astro.props;
const t = useTranslations(lang);
const emptyKey = `section.${id}.empty` as UiKey;

const metaLabel =
	projects.length === 0
		? t("section.meta.vertical")
		: `${projects.length} ${
				projects.length === 1
					? t("section.meta.project")
					: t("section.meta.projects")
			}`;

/** Indie / Local: even 16:9 tiles. BTS keeps mosaic. */
const useUniformGrid = id === "indie" || id === "local";
const spans = useUniformGrid ? undefined : mosaicSpans(projects.length);

const EXPANDABLE_IDS = new Set(["indie", "local", "bts"]);
const MAX_VISIBLE_ROWS = 3;
const UNIFORM_COLUMNS = 2;
const rowSizes = useUniformGrid
	? Array.from(
			{ length: Math.ceil(projects.length / UNIFORM_COLUMNS) },
			(_, row) =>
				Math.min(UNIFORM_COLUMNS, projects.length - row * UNIFORM_COLUMNS),
		)
	: mosaicRowSizes(projects.length);
const canCollapse =
	EXPANDABLE_IDS.has(id) && rowSizes.length > MAX_VISIBLE_ROWS;
const visibleCount = canCollapse
	? rowSizes
			.slice(0, MAX_VISIBLE_ROWS)
			.reduce((sum, size) => sum + size, 0)
	: projects.length;
---

<section
	class:list={[
		"work-section",
		`work-section--${id}`,
		{
			"work-section--shorts": id === "shorts",
			"work-section--uniform": useUniformGrid,
		},
	]}
	id={id}
	aria-labelledby={`${id}-title`}
	data-nav-section
	data-work-expandable={canCollapse ? true : undefined}
>
	<header class="section-heading" data-reveal>
		<p class="section-heading__ghost" aria-hidden="true">{number}</p>
		<div class="section-heading__meta">
			<p>{number}</p>
			<p>{metaLabel}</p>
		</div>
		<h2 id={`${id}-title`}>{title}</h2>
		<p class="section-heading__description">{description}</p>
	</header>

	{
		projects.length > 0 ? (
			<>
				<div
					class:list={[
						"project-grid",
						{ "project-grid--uniform": useUniformGrid },
					]}
				>
					{projects.map((project, index) => (
						<ProjectCard
							project={project}
							lang={lang}
							index={index}
							span={spans?.[index]}
							overflow={canCollapse && index >= visibleCount}
						/>
					))}
				</div>
				{canCollapse && (
					<button
						class="work-section__more"
						type="button"
						data-work-expand
						aria-expanded="false"
						data-label-more={t("section.seeMore")}
						data-label-less={t("section.showLess")}
					>
						<span data-work-expand-label>{t("section.seeMore")}</span>
						<svg viewBox="0 0 18 18" aria-hidden="true">
							<path d="M9 2v13M4 10l5 5 5-5"></path>
						</svg>
					</button>
				)}
			</>
		) : (
			<p class="work-section__empty" data-reveal>
				{t(emptyKey)}
			</p>
		)
	}
</section>
