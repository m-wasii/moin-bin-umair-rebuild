---
import type { Project } from "../data/projects";
import { useTranslations, type Lang } from "../i18n/ui";
import ProjectCard from "./ProjectCard.astro";

interface Props {
	id: "commercial" | "art" | "shorts";
	number: string;
	title: string;
	description: string;
	projects: Project[];
	lang: Lang;
}

const { id, number, title, description, projects, lang } = Astro.props;
const t = useTranslations(lang);

const metaLabel =
	projects.length === 0
		? t("section.meta.vertical")
		: `${projects.length} ${
				projects.length === 1
					? t("section.meta.project")
					: t("section.meta.projects")
			}`;
---

<section
	class:list={["work-section", { "work-section--shorts": id === "shorts" }]}
	id={id}
	aria-labelledby={`${id}-title`}
	data-nav-section
>
	<header class="section-heading" data-reveal>
		<div class="section-heading__meta">
			<p class="section-heading__index">{number}</p>
			<p>{metaLabel}</p>
		</div>
		<h2 id={`${id}-title`}>{title}</h2>
		<p class="section-heading__description">{description}</p>
	</header>

	{
		projects.length > 0 ? (
			<div class="project-grid">
				{projects.map((project) => (
					<ProjectCard project={project} lang={lang} />
				))}
			</div>
		) : (
			<p class="work-section__empty" data-reveal>
				{t("section.shorts.empty")}
			</p>
		)
	}
</section>
