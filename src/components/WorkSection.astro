---
import type { Project } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
	id: "commercial" | "art";
	title: string;
	description: string;
	projects: Project[];
}

const { id, title, description, projects } = Astro.props;
---

<section
	class="work-section"
	id={id}
	aria-labelledby={`${id}-title`}
	data-nav-section
>
	<header class="section-heading" data-reveal>
		<p class="eyebrow">{title}</p>
		<h2 id={`${id}-title`}>{description}</h2>
		<p class="section-heading__count">{projects.length} films</p>
	</header>

	<div class="project-grid">
		{
			projects.map((project) => (
				<ProjectCard project={project} />
			))
		}
	</div>
</section>
