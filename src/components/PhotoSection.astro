---
import type { StoredPhoto } from "../data/photos";
import { listPhotoCategories } from "../lib/store";
import {
	cfImageResizingAvailable,
	RESPONSIVE_WIDTHS,
} from "../lib/responsive-image";
import { serializeJsonForScript } from "../lib/serialize-json-for-script";
import { useTranslations, type Lang, type UiKey } from "../i18n/ui";
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
	photos: StoredPhoto[];
	lang: Lang;
	surface?: "section" | "overlays";
}

const { photos, lang, surface = "section" } = Astro.props;
const t = useTranslations(lang);
const categories = await listPhotoCategories();
const cfImages = cfImageResizingAvailable(Astro.url.hostname);

function albumTitle(slug: string, label: string) {
	const key = `photo.category.${slug}` as UiKey;
	const translated = t(key);
	return typeof translated === "string" && translated.length > 0
		? translated
		: label;
}

const grouped = categories
	.map((category) => ({
		category: category.slug,
		title: albumTitle(category.slug, category.label),
		items: photos.filter((photo) => photo.category === category.slug),
	}))
	.filter((group) => group.items.length > 0);

// Trieste full-width first; remaining albums share the grid; new albums at end.
const albumSpans = [12, 7, 5, 5, 7, 6, 6, 6, 6, 6];
---

{
	surface === "section" && (
		<section
			class="work-section photo-section"
			id="photography"
			aria-labelledby="photography-title"
			data-nav-section
		>
			<header class="section-heading">
				<p class="section-heading__ghost" aria-hidden="true">
					04
				</p>
				<div class="section-heading__meta">
					<p>04</p>
					<p>
						{photos.length === 0
							? t("section.meta.stills")
							: `${grouped.length} ${
									grouped.length === 1
										? t("section.meta.album")
										: t("section.meta.albums")
								}`}
					</p>
				</div>
				<h2 id="photography-title" data-text-reveal="words">
					{t("section.photography.title")}
				</h2>
				<p class="section-heading__description" data-text-reveal>
					{t("section.photography.description")}
				</p>
			</header>

			{grouped.length === 0 ? (
				<p class="work-section__empty" data-text-reveal>
					{t("section.photography.empty")}
				</p>
			) : (
				<ul class="photo-albums">
					{grouped.map((group, albumIndex) => {
						const cover = group.items[0];
						const peek = group.items.slice(1, 3);
						const countLabel = t("photo.album.count", {
							count: group.items.length,
						});
						const indexLabel = String(albumIndex + 1).padStart(2, "0");
						return (
							<li
								class="photo-album"
								style={`--album-span: ${albumSpans[albumIndex] ?? 6}; --album-index: ${albumIndex}`}
								data-reveal
							>
								<button
									class="photo-album__hit"
									type="button"
									data-album-open={group.category}
									aria-label={t("photo.album.open", { title: group.title })}
									aria-haspopup="dialog"
									aria-controls={`album-${group.category}`}
								>
									<div class="photo-album__stack">
										{peek.map((photo, peekIndex) => (
											<span
												class={`photo-album__peek photo-album__peek--${peekIndex + 1}`}
												aria-hidden="true"
											>
												<ResponsiveImage
													src={photo.src}
													alt=""
													width={800}
													height={1000}
													widths={RESPONSIVE_WIDTHS.album}
													sizes="(max-width: 760px) 45vw, 22vw"
													loading="lazy"
													decoding="async"
													cfImages={cfImages}
												/>
											</span>
										))}
										<figure class="photo-album__frame">
											<ResponsiveImage
												src={cover.src}
												alt=""
												width={1600}
												height={1200}
												widths={RESPONSIVE_WIDTHS.album}
												sizes="(max-width: 760px) 90vw, 42vw"
												loading="lazy"
												decoding="async"
												cfImages={cfImages}
											/>
											<span class="photo-album__mask" aria-hidden="true" />
											<figcaption class="photo-album__content">
												<p class="photo-album__kicker">
													{t("photo.album.kicker")} · {indexLabel}
												</p>
												<h3>{group.title}</h3>
												<p>{countLabel}</p>
											</figcaption>
											<span class="photo-album__arrow" aria-hidden="true">
												<svg viewBox="0 0 24 24">
													<path d="M7 17 17 7M9 7h8v8" />
												</svg>
											</span>
										</figure>
									</div>
								</button>
							</li>
						);
					})}
				</ul>
			)}
		</section>
	)
}

{
	surface === "overlays" &&
		grouped.map((group) => {
			const albumPhotos = group.items.map((photo) => ({
				src: photo.src,
				alt: photo.alt || group.title,
			}));
			return (
				<div
					class="album-overlay"
					id={`album-${group.category}`}
					data-album-panel={group.category}
					hidden
				>
					<div
						class="album-overlay__backdrop"
						data-album-backdrop
						aria-hidden="true"
					/>
					<div
						class="album-overlay__dialog"
						role="dialog"
						aria-modal="true"
						aria-labelledby={`album-title-${group.category}`}
					>
						<header class="album-overlay__header">
							<button type="button" data-album-close>
								{t("photo.album.back")}
							</button>
							<div>
								<p class="photo-album__kicker">{t("photo.album.kicker")}</p>
								<h2 id={`album-title-${group.category}`}>{group.title}</h2>
							</div>
							<p>
								{t("photo.album.count", {
									count: group.items.length,
								})}
							</p>
						</header>
						{/* Masonry is injected on open — keeps ~214 photos out of initial DOM. */}
						<ul class="album-masonry" data-album-masonry></ul>
						<script
							type="application/json"
							is:inline
							data-album-photos
							set:html={serializeJsonForScript(albumPhotos)}
						/>
					</div>
				</div>
			);
		})
}
