---
import type { StoredPhoto } from "../data/photos";
import { photoCategories } from "../data/photos";
import { useTranslations, type Lang, type UiKey } from "../i18n/ui";

interface Props {
	photos: StoredPhoto[];
	lang: Lang;
	surface?: "section" | "overlays";
}

const { photos, lang, surface = "section" } = Astro.props;
const t = useTranslations(lang);

const grouped = photoCategories
	.map((category) => ({
		category,
		title: t(`photo.category.${category}` as UiKey),
		items: photos.filter((photo) => photo.category === category),
	}))
	.filter((group) => group.items.length > 0);

// Trieste full-width first; events + street slightly smaller on the last row.
const albumSpans = [12, 7, 5, 5, 7, 6, 6];
---

{
	surface === "section" && (
		<section
			class="work-section photo-section"
			id="photography"
			aria-labelledby="photography-title"
			data-nav-section
		>
			<header class="section-heading" data-reveal>
				<p class="section-heading__ghost" aria-hidden="true">
					03
				</p>
				<div class="section-heading__meta">
					<p>03</p>
					<p>
						{photos.length === 0
							? t("section.meta.stills")
							: `${grouped.length} ${
									grouped.length === 1
										? t("section.meta.album")
										: t("section.meta.albums")
								}`}
					</p>
				</div>
				<h2 id="photography-title">{t("section.photography.title")}</h2>
				<p class="section-heading__description">
					{t("section.photography.description")}
				</p>
			</header>

			{grouped.length === 0 ? (
				<p class="work-section__empty" data-reveal>
					{t("section.photography.empty")}
				</p>
			) : (
				<ul class="photo-albums">
					{grouped.map((group, albumIndex) => {
						const cover = group.items[0];
						const peek = group.items.slice(1, 3);
						const countLabel = t("photo.album.count", {
							count: group.items.length,
						});
						const indexLabel = String(albumIndex + 1).padStart(2, "0");
						return (
							<li
								class="photo-album"
								style={`--album-span: ${albumSpans[albumIndex] ?? 6}; --album-index: ${albumIndex}`}
								data-reveal
							>
								<button
									class="photo-album__hit"
									type="button"
									data-album-open={group.category}
									aria-haspopup="dialog"
									aria-controls={`album-${group.category}`}
								>
									<div class="photo-album__stack">
										{peek.map((photo, peekIndex) => (
											<span
												class={`photo-album__peek photo-album__peek--${peekIndex + 1}`}
												aria-hidden="true"
											>
												<img
													src={photo.src}
													alt=""
													width="800"
													height="1000"
													loading="lazy"
													decoding="async"
												/>
											</span>
										))}
										<figure class="photo-album__frame">
											<img
												src={cover.src}
												alt=""
												width="1600"
												height="1200"
												loading={albumIndex < 2 ? "eager" : "lazy"}
												decoding="async"
											/>
											<span class="photo-album__mask" aria-hidden="true" />
											<figcaption class="photo-album__content">
												<p class="photo-album__kicker">
													{t("photo.album.kicker")} · {indexLabel}
												</p>
												<h3>{group.title}</h3>
												<p>{countLabel}</p>
											</figcaption>
											<span class="photo-album__arrow" aria-hidden="true">
												<svg viewBox="0 0 24 24">
													<path d="M7 17 17 7M9 7h8v8" />
												</svg>
											</span>
										</figure>
									</div>
									<span class="sr-only">
										{t("photo.album.open", { title: group.title })}
									</span>
								</button>
							</li>
						);
					})}
				</ul>
			)}
		</section>
	)
}

{
	surface === "overlays" &&
		grouped.map((group) => (
			<div
				class="album-overlay"
				id={`album-${group.category}`}
				data-album-panel={group.category}
				hidden
			>
				<div
					class="album-overlay__backdrop"
					data-album-backdrop
					aria-hidden="true"
				/>
				<div
					class="album-overlay__dialog"
					role="dialog"
					aria-modal="true"
					aria-labelledby={`album-title-${group.category}`}
				>
					<header class="album-overlay__header">
						<button type="button" data-album-close>
							{t("photo.album.back")}
						</button>
						<div>
							<p class="photo-album__kicker">{t("photo.album.kicker")}</p>
							<h2 id={`album-title-${group.category}`}>{group.title}</h2>
						</div>
						<p>
							{t("photo.album.count", {
								count: group.items.length,
							})}
						</p>
					</header>
					<ul class="album-masonry">
						{group.items.map((photo, index) => (
							<li
								class:list={[
									"album-masonry__item",
									`album-masonry__item--${(index % 5) + 1}`,
								]}
							>
								<button
									class="photo-card"
									type="button"
									data-photo
									data-photo-src={photo.src}
									data-photo-alt={photo.alt || group.title}
									data-photo-group={group.items
										.map((item) => item.src)
										.join("|")}
									data-photo-index={String(index)}
								>
									<img
										src={photo.src}
										alt={photo.alt || group.title}
										width="1200"
										height="1500"
										loading="lazy"
										decoding="async"
									/>
								</button>
							</li>
						))}
					</ul>
				</div>
			</div>
		))
}
