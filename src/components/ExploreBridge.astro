---
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
	nextHref: string;
	nextLabel: string;
}

const { lang, nextHref, nextLabel } = Astro.props;
const t = useTranslations(lang);
---

<nav class="explore-bridge" aria-label={t("bridge.aria")} data-reveal>
	<a class="explore-bridge__next" href={nextHref}>
		<span>{nextLabel}</span>
		<svg viewBox="0 0 18 18" aria-hidden="true">
			<path d="M9 2v13M4 10l5 5 5-5"></path>
		</svg>
	</a>
	<a class="explore-bridge__contact" href="#contact">
		{t("bridge.contact")}
	</a>
</nav>
