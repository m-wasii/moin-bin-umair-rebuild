---
import type { MosaicSpan } from "../lib/mosaic";
import type { Project } from "../data/projects";
import {
	formatDuration,
	projectHostLabel,
	projectProvider,
	projectWatchUrl,
} from "../data/projects";
import { localizedProjectDescription } from "../i18n/project-descriptions";
import { useTranslations, type Lang } from "../i18n/ui";
import { buildProjectThumbnailAttrs } from "../lib/project-thumbnail";

interface Props {
	project: Project;
	lang: Lang;
	index?: number;
	span?: MosaicSpan;
	overflow?: boolean;
}

const { project, lang, index = 0, span, overflow = false } = Astro.props;
const t = useTranslations(lang);
const watchUrl = projectWatchUrl(project);
const hostLabel = projectHostLabel(project);
const isVertical = project.category === "shorts";
const description = localizedProjectDescription(project, lang);
const thumb = buildProjectThumbnailAttrs(
	project.thumbnail,
	isVertical
		? "(max-width: 760px) 42vw, 18vw"
		: "(max-width: 760px) 92vw, (max-width: 1100px) 46vw, 32vw",
);
---

<article
	class:list={[
		"project-card",
		{
			"project-card--featured": project.featured && !isVertical,
			"project-card--vertical": isVertical,
		},
	]}
	style={span != null
		? `--card-index: ${index}; --card-span: ${span}`
		: `--card-index: ${index}`}
	data-reveal
	data-work-overflow={overflow ? true : undefined}
	hidden={overflow}
>
	<a
		class="project-card__link"
		href={watchUrl}
		rel="noopener noreferrer"
		data-video
		data-video-id={project.id}
		data-video-provider={projectProvider(project)}
		data-video-title={project.title}
		data-video-description={description}
		data-video-orientation={isVertical ? "portrait" : "landscape"}
		aria-label={t("card.playAria", { title: project.title, host: hostLabel })}
	>
		<figure class="project-card__frame">
			<img
				src={thumb.src}
				srcset={thumb.srcset}
				sizes={thumb.sizes}
				alt={t("card.stillAlt", { title: project.title })}
				width={isVertical ? 1080 : 1280}
				height={isVertical ? 1920 : 720}
				loading="lazy"
				decoding="async"
				referrerpolicy="no-referrer"
			/>
			<span class="project-card__wash" aria-hidden="true"></span>
			<span class="project-card__play" aria-hidden="true">
				<svg viewBox="0 0 24 24">
					<path d="m9 7 8 5-8 5V7Z"></path>
				</svg>
				<span>{t("card.play")}</span>
			</span>
			<figcaption class="project-card__meta">
				<h3>{project.title}</h3>
				<p>
					<span>{project.year}</span>
					<span aria-hidden="true">·</span>
					<span>{formatDuration(project.duration)}</span>
				</p>
			</figcaption>
		</figure>
	</a>
</article>
