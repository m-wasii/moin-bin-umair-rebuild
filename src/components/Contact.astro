---
import { site } from "../data/site";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<section
	class="contact"
	id="contact"
	aria-labelledby="contact-title"
	data-nav-section
>
	<header class="section-heading section-heading--contact" data-reveal>
		<div class="section-heading__meta">
			<p>04</p>
			<p>{t("contact.meta")}</p>
		</div>
		<h2 id="contact-title" set:html={t("contact.titleHtml")} />
		<p class="section-heading__description">
			{t("contact.description")}
		</p>
	</header>

	<div class="contact__actions" data-reveal>
		<p class="contact__location">{site.location}</p>
		<a class="text-link" href={`mailto:${site.email}`}>
			<span>{t("contact.email")}</span>
			<span aria-hidden="true">↗</span>
		</a>
		<a
			class="text-link"
			href={site.instagramUrl}
			target="_blank"
			rel="noreferrer"
		>
			<span>{t("contact.instagram")}</span>
			<span aria-hidden="true">↗</span>
		</a>
	</div>

	<footer class="site-footer">
		<p>{site.name} © {year}</p>
		<a href="#home">{t("contact.backToTop")}</a>
	</footer>
</section>
