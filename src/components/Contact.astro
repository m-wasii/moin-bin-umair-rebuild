---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<section
	class="contact"
	id="contact"
	aria-labelledby="contact-title"
	data-nav-section
>
	<header class="section-heading" data-reveal>
		<p class="eyebrow">Contact</p>
		<h2 id="contact-title">Let’s make something worth watching.</h2>
		<p class="section-heading__count">
			Commercial films, narrative projects, and creative collaborations.
		</p>
	</header>

	<div class="contact__actions" data-reveal>
		<a class="button" href={site.vimeoUrl} target="_blank" rel="noreferrer">
			Visit Vimeo
			<span aria-hidden="true">↗</span>
		</a>
	</div>

	<footer class="site-footer">
		<p>{site.name} © {year}</p>
		<p>{site.hero.tagline.join(" · ")}</p>
		<a href="#home">Back to top</a>
	</footer>
</section>
