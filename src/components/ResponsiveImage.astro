---
import {
	buildResponsiveImageAttrs,
	type ResponsiveImageAttrs,
} from "../lib/responsive-image";

interface Props extends ResponsiveImageAttrs {
	widths: readonly number[];
	sizes: string;
	cfImages?: boolean;
}

const {
	widths,
	sizes,
	src,
	width,
	height,
	loading,
	decoding,
	fetchpriority,
	alt,
	class: className,
	cfImages,
} = Astro.props;

const attrs = buildResponsiveImageAttrs({
	src,
	widths,
	sizes,
	width,
	height,
	loading,
	decoding,
	fetchpriority,
	alt,
	class: className,
	cfImages,
});
---

<img {...attrs} />
