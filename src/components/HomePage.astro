---
import About from "./About.astro";
import Contact from "./Contact.astro";
import Hero from "./Hero.astro";
import PhotoDialog from "./PhotoDialog.astro";
import PhotoSection from "./PhotoSection.astro";
import ShortsSection from "./ShortsSection.astro";
import SiteHeader from "./SiteHeader.astro";
import VideoDialog from "./VideoDialog.astro";
import WorkSection from "./WorkSection.astro";
import { loadPhotos, loadProjects, loadShorts } from "../lib/content";
import { useTranslations, type Lang } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { indie, local, bts } = await loadProjects();
const { campaigns, singles } = await loadShorts();
const photos = await loadPhotos();
---

<BaseLayout lang={lang}>
	<SiteHeader lang={lang} />

	<main id="main-content">
		<div class="site-video" aria-hidden="true">
			<video
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster="/media/hero-poster.webp"
				tabindex="-1"
				data-hero-video
			>
				<source src="/media/hero-loop.mp4" type="video/mp4" />
			</video>
		</div>

		<Hero lang={lang} />

		<About lang={lang} />

		<WorkSection
			id="indie"
			number="02"
			title={t("section.indie.title")}
			description={t("section.indie.description")}
			projects={indie}
			lang={lang}
		/>

		<WorkSection
			id="local"
			number="03"
			title={t("section.local.title")}
			description={t("section.local.description")}
			projects={local}
			lang={lang}
		/>

		<PhotoSection photos={photos} lang={lang} />

		<WorkSection
			id="bts"
			number="05"
			title={t("section.bts.title")}
			description={t("section.bts.description")}
			projects={bts}
			lang={lang}
		/>

		{/* Alyy’s vertical series titles TBD — do not invent placeholders. */}
		<ShortsSection campaigns={campaigns} singles={singles} lang={lang} />

		<Contact lang={lang} />
	</main>

	<PhotoSection photos={photos} lang={lang} surface="overlays" />
	<VideoDialog lang={lang} />
	<PhotoDialog lang={lang} />
</BaseLayout>
