---
import Contact from "./Contact.astro";
import Hero from "./Hero.astro";
import PhotoDialog from "./PhotoDialog.astro";
import PhotoSection from "./PhotoSection.astro";
import ShortsSection from "./ShortsSection.astro";
import SiteHeader from "./SiteHeader.astro";
import VideoDialog from "./VideoDialog.astro";
import WorkSection from "./WorkSection.astro";
import { loadPhotos, loadProjects, loadShorts } from "../lib/content";
import { useTranslations, type Lang } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { commercial, art } = await loadProjects();
const { campaigns, singles } = await loadShorts();
const photos = await loadPhotos();
---

<BaseLayout lang={lang}>
	<SiteHeader lang={lang} />

	<main id="main-content">
		<Hero lang={lang} />

		<WorkSection
			id="commercial"
			number="01"
			title={t("section.commercial.title")}
			description={t("section.commercial.description")}
			projects={commercial}
			lang={lang}
		/>

		<WorkSection
			id="art"
			number="02"
			title={t("section.art.title")}
			description={t("section.art.description")}
			projects={art}
			lang={lang}
		/>

		<PhotoSection photos={photos} lang={lang} />

		<ShortsSection campaigns={campaigns} singles={singles} lang={lang} />

		<Contact lang={lang} />
	</main>

	<PhotoSection photos={photos} lang={lang} surface="overlays" />
	<VideoDialog lang={lang} />
	<PhotoDialog lang={lang} />
</BaseLayout>
