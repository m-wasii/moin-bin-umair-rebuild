---
import { site } from "../data/site";
import { useTranslations, type Lang } from "../i18n/ui";
import { heroMediaSrc, heroMediaVersion } from "../lib/store";
import ResponsiveImage from "./ResponsiveImage.astro";
import { RESPONSIVE_WIDTHS } from "../lib/responsive-image";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const heroVersion = await heroMediaVersion();
const heroPoster = heroMediaSrc("hero-poster.webp", heroVersion);
const heroLoop = heroMediaSrc("hero-loop.mp4", heroVersion);
---

<section class="hero" id="home" aria-labelledby="hero-title" data-nav-section>
	<div class="hero__media" aria-hidden="true" data-hero-media>
		{/* Poster is the LCP candidate; video loads after idle so it does not compete. */}
		<ResponsiveImage
			class="hero__media-poster"
			src={heroPoster}
			alt=""
			width={1920}
			height={1080}
			widths={RESPONSIVE_WIDTHS.hero}
			sizes="100vw"
			decoding="async"
			fetchpriority="high"
		/>
		<video
			muted
			loop
			playsinline
			preload="none"
			tabindex="-1"
			data-hero-video
			data-hero-src={heroLoop}
		>
		</video>
		<div class="hero__veil"></div>
		<div class="hero__grain"></div>
	</div>

	<h1 class="sr-only" id="hero-title">{site.name}</h1>

	<div class="hero__orbit" aria-hidden="true">
		<svg viewBox="0 0 200 200">
			<defs>
				<path
					id="hero-orbit-path"
					d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"
				></path>
			</defs>
			<text>
				<textPath href="#hero-orbit-path">{t("hero.orbit")}</textPath>
			</text>
		</svg>
	</div>

	<div class="hero__footer">
		<p class="hero__tagline" data-text-reveal="words">{t("hero.tagline")}</p>
		<a class="hero__scroll" href="#indie">
			<span data-text-reveal="words">{t("hero.explore")}</span>
			<svg viewBox="0 0 18 18" aria-hidden="true">
				<path d="M9 2v13M4 10l5 5 5-5"></path>
			</svg>
		</a>
	</div>
</section>
