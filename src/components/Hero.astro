---
import { site } from "../data/site";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" id="home" aria-labelledby="hero-title" data-nav-section>
	<div class="hero__media" aria-hidden="true">
		<video
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster="/media/hero-poster.webp"
			tabindex="-1"
			data-hero-video
		>
			<source src="/media/hero-loop.mp4" type="video/mp4" />
		</video>
		<div class="hero__veil"></div>
		<div class="hero__grain"></div>
	</div>

	<div class="hero__stage">
		<p class="hero__edge" aria-hidden="true">{t("hero.edge")}</p>
		<p class="hero__title" id="hero-title">{site.name}</p>
		<p class="hero__tagline">{t("hero.tagline")}</p>
		<div class="hero__actions">
			<a class="hero__scroll" href="#indie">
				<span>{t("hero.explore")}</span>
				<svg viewBox="0 0 18 18" aria-hidden="true">
					<path d="M9 2v13M4 10l5 5 5-5"></path>
				</svg>
			</a>
			<a class="hero__contact" href="#contact">{t("hero.contact")}</a>
		</div>
	</div>
</section>
