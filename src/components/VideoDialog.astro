---
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
	class="video-overlay"
	data-video-dialog
	data-label-project-film={t("dialog.projectFilm")}
	data-label-open-vimeo={t("dialog.openVimeo")}
	data-label-open-youtube={t("dialog.openYoutube")}
	data-label-no-description={t("dialog.noDescription")}
	data-label-clip-of={t("shorts.clipOf")}
	hidden
>
	<div class="video-overlay__backdrop" data-video-backdrop aria-hidden="true"></div>
	<div
		class="video-dialog__panel"
		role="dialog"
		aria-modal="true"
		aria-labelledby="video-dialog-title"
	>
		<header class="video-dialog__header">
			<p id="video-dialog-title" data-video-dialog-title>
				{t("dialog.projectFilm")}
			</p>
			<div class="video-dialog__actions">
				<button
					class="video-dialog__about"
					type="button"
					data-video-about-toggle
					aria-expanded="true"
					aria-controls="video-dialog-about"
				>
					{t("dialog.about")}
				</button>
				<button class="video-dialog__close" type="button" data-video-close>
					<span>{t("dialog.close")}</span>
					<svg viewBox="0 0 18 18" aria-hidden="true">
						<path d="m3 3 12 12M15 3 3 15"></path>
					</svg>
				</button>
			</div>
		</header>

		<div class="video-dialog__body" data-video-body>
			<div class="video-dialog__player" data-video-player></div>
			<aside
				class="video-dialog__about-panel"
				id="video-dialog-about"
				data-video-about-panel
			>
				<p class="video-dialog__about-label">{t("dialog.aboutLabel")}</p>
				<p class="video-dialog__description" data-video-dialog-description></p>
			</aside>
		</div>

		<nav class="video-dialog__playlist" data-video-playlist hidden>
			<button type="button" data-video-prev>{t("photo.prev")}</button>
			<p data-video-playlist-count></p>
			<button type="button" data-video-next>{t("photo.next")}</button>
		</nav>

		<a
			class="video-dialog__external"
			href="https://vimeo.com/moonshine123"
			target="_blank"
			rel="noreferrer"
			data-video-external
		>
			<span data-video-external-label>{t("dialog.openVimeo")}</span>
			<span aria-hidden="true">↗</span>
		</a>
	</div>
</div>
