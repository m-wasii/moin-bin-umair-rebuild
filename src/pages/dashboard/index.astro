---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PageHeader from "../../components/dashboard/PageHeader.astro";
import StatusBadge from "../../components/dashboard/StatusBadge.astro";
import { readDashboardCatalogSnapshot } from "../../lib/dashboard/catalog-snapshot";

export const prerender = false;

const snapshot = await readDashboardCatalogSnapshot();
/** Storage readiness is not a publish lifecycle — keep wording distinct. */
const storageStatus = snapshot.writable
	? {
			label: "Storage ready",
			tone: "neutral" as const,
			detail: "MEDIA bound — catalogs can publish",
		}
	: {
			label: "Storage unavailable",
			tone: "danger" as const,
			detail: "MEDIA bucket is not bound",
		};
---

<DashboardLayout
	title="Home"
	section="home"
	revisions={snapshot.revisions}
	statusLabel={storageStatus.label}
	statusTone={storageStatus.tone}
>
	<div class="dash-home">
		<PageHeader
			eyebrow="Studio"
			title="Attention board"
			description="What needs attention across the live portfolio catalogs. Counts and gaps come from real storage — nothing fabricated."
		>
			<div slot="actions" class="dash-quick-actions">
				<a class="dash-btn dash-btn--primary" href="/dashboard/videos"
					>Add video</a
				>
				<a class="dash-btn dash-btn--secondary" href="/dashboard/photos"
					>Upload photos</a
				>
				<a class="dash-btn dash-btn--secondary" href="/dashboard/shorts"
					>Manage shorts</a
				>
			</div>
		</PageHeader>

		<section class="dash-panel" aria-labelledby="dash-home-status">
			<h2 class="dash-panel__title" id="dash-home-status">System</h2>
			<div class="dash-quick-actions">
				<StatusBadge tone={storageStatus.tone} label={storageStatus.label} />
			</div>
			{
				!snapshot.writable && (
					<p class="dash-inline-error">
						Saves need a MEDIA binding before publish status can advance.
					</p>
				)
			}
		</section>

		<div class="dash-home__grid">
			<section class="dash-panel" aria-labelledby="dash-home-counts">
				<h2 class="dash-panel__title" id="dash-home-counts">Content</h2>
				<div class="dash-count-row">
					<div class="dash-count">
						<span class="dash-count__value">{snapshot.counts.videos}</span>
						<span class="dash-count__label">Videos</span>
					</div>
					<div class="dash-count">
						<span class="dash-count__value">{snapshot.counts.albums}</span>
						<span class="dash-count__label">Albums</span>
					</div>
					<div class="dash-count">
						<span class="dash-count__value">{snapshot.counts.photos}</span>
						<span class="dash-count__label">Photos</span>
					</div>
					<a class="dash-count" href="/dashboard/shorts">
						<span class="dash-count__value">{snapshot.counts.shorts}</span>
						<span class="dash-count__label">Shorts</span>
					</a>
				</div>
				<p class="dash-muted">
					Shorts: {snapshot.counts.shortCampaigns} campaigns ·{" "}
					{snapshot.counts.shortSingles} singles
				</p>
			</section>

			<section class="dash-panel dash-hero-snap" aria-labelledby="dash-home-hero">
				<h2 class="dash-panel__title" id="dash-home-hero">Hero</h2>
				{
					snapshot.hero.posterSrc ? (
						<div class="dash-hero-snap__media">
							<img
								src={snapshot.hero.posterSrc}
								alt="Current public hero poster"
								width="960"
								height="540"
								loading="lazy"
								decoding="async"
							/>
						</div>
					) : (
						<p class="dash-muted">Hero poster is not available.</p>
					)
				}
				<p class="dash-hero-snap__meta">
					Live version {snapshot.hero.version}
					{
						!snapshot.hero.loopPresent || !snapshot.hero.posterPresent
							? " · incomplete media"
							: ""
					}
				</p>
				<a class="dash-btn dash-btn--ghost" href="/dashboard/site">Open Site / Hero</a>
			</section>
		</div>

		<section class="dash-panel" aria-labelledby="dash-home-attention">
			<h2 class="dash-panel__title" id="dash-home-attention">Needs attention</h2>
			<ul class="dash-attention">
				{
					snapshot.attention.map((item) => (
						<li class="dash-attention__item">
							<p class="dash-attention__title">{item.title}</p>
							<p class="dash-attention__detail">{item.detail}</p>
							{item.href && (
								<a class="dash-link" href={item.href}>
									Open
								</a>
							)}
						</li>
					))
				}
			</ul>
		</section>
	</div>
</DashboardLayout>
