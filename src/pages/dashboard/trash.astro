---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import {
	hasWritableMedia,
	listPhotoCategories,
	listPhotos,
	listVideos,
} from "../../lib/store";

export const prerender = false;

const [photos, categories, videos] = await Promise.all([
	listPhotos({ includeDeleted: true }),
	listPhotoCategories({ includeDeleted: true }),
	listVideos({ includeDeleted: true }),
]);
const writable = hasWritableMedia();

const trashedCategories = categories.filter((entry) => entry.deletedAt);
const categoryBundles = trashedCategories.map((category) => ({
	category,
	photos: photos.filter((photo) => photo.trashedWithCategory === category.slug),
}));
const standalonePhotos = photos.filter(
	(photo) => photo.deletedAt && !photo.trashedWithCategory,
);
const trashedVideos = videos.filter((video) => video.deletedAt);
const isEmpty =
	categoryBundles.length === 0 &&
	standalonePhotos.length === 0 &&
	trashedVideos.length === 0;
---

<DashboardLayout title="Trash" section="trash">
	<header class="dash-heading">
		<div>
			<p>Recoverable</p>
			<h1>Trash</h1>
		</div>
		<p>
			Restore items, delete forever, or empty trash. Nothing expires
			automatically.
		</p>
	</header>

	{
		!writable && (
			<p class="dash-banner" role="status">
				R2 is not bound on this Worker yet. Trash actions need a MEDIA bucket.
			</p>
		)
	}

	{
		!isEmpty && (
			<div class="dash-toolbar">
				<p class="dash-muted">Manual purge only — restore anytime.</p>
				<button type="button" class="dash-danger" data-empty-trash>
					Empty trash
				</button>
			</div>
		)
	}

	{
		isEmpty ? (
			<p class="dash-muted">Trash is empty.</p>
		) : (
			<>
				{trashedVideos.length > 0 && (
					<section class="dash-trash-section">
						<h2>Videos</h2>
						<ul class="dash-trash-list">
							{trashedVideos.map((video) => (
								<li>
									<div>
										<strong>{video.title}</strong>
										<div class="dash-muted">
											{video.category} · {video.provider}
										</div>
									</div>
									<div class="dash-trash-actions">
										<button
											type="button"
											data-restore
											data-kind="video"
											data-slug={video.slug}
										>
											Restore
										</button>
										<button
											type="button"
											class="dash-danger-outline"
											data-purge
											data-kind="video"
											data-slug={video.slug}
										>
											Delete forever
										</button>
									</div>
								</li>
							))}
						</ul>
					</section>
				)}

				{categoryBundles.length > 0 && (
					<section class="dash-trash-section">
						<h2>Categories</h2>
						<ul class="dash-trash-list">
							{categoryBundles.map(({ category, photos: bundled }) => (
								<li>
									<div>
										<strong>{category.label}</strong>
										<div class="dash-muted">
											Category · {bundled.length} photo
											{bundled.length === 1 ? "" : "s"} (restored together)
										</div>
										{bundled.length > 0 && (
											<ul class="dash-trash-nested">
												{bundled.map((photo) => (
													<li>{photo.title}</li>
												))}
											</ul>
										)}
									</div>
									<div class="dash-trash-actions">
										<button
											type="button"
											data-restore
											data-kind="category"
											data-slug={category.slug}
										>
											Restore
										</button>
										<button
											type="button"
											class="dash-danger-outline"
											data-purge
											data-kind="category"
											data-slug={category.slug}
										>
											Delete forever
										</button>
									</div>
								</li>
							))}
						</ul>
					</section>
				)}

				{standalonePhotos.length > 0 && (
					<section class="dash-trash-section">
						<h2>Photos</h2>
						<ul class="dash-trash-list">
							{standalonePhotos.map((photo) => (
								<li>
									<div class="dash-trash-photo">
										<img src={photo.src} alt={photo.alt} />
										<div>
											<strong>{photo.title}</strong>
											<div class="dash-muted">{photo.category}</div>
										</div>
									</div>
									<div class="dash-trash-actions">
										<button
											type="button"
											data-restore
											data-kind="photo"
											data-slug={photo.slug}
											data-category={photo.category}
										>
											Restore
										</button>
										<button
											type="button"
											class="dash-danger-outline"
											data-purge
											data-kind="photo"
											data-slug={photo.slug}
											data-category={photo.category}
										>
											Delete forever
										</button>
									</div>
								</li>
							))}
						</ul>
					</section>
				)}
			</>
		)
	}
</DashboardLayout>

<script>
	async function trashAction(
		body: Record<string, unknown>,
		confirmMessage: string,
	) {
		if (!confirm(confirmMessage)) return;
		const response = await fetch("/api/trash", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify(body),
		});
		const result = await response.json();
		if (!response.ok) {
			alert(result.error ?? "Action failed.");
			return;
		}
		location.reload();
	}

	document.addEventListener("click", async (event) => {
		const target = event.target as HTMLElement;
		const restore = target.closest<HTMLButtonElement>("[data-restore]");
		if (restore) {
			await trashAction(
				{
					action: "restore",
					kind: restore.dataset.kind,
					slug: restore.dataset.slug,
					category: restore.dataset.category,
				},
				"Restore this item?",
			);
			return;
		}

		const purge = target.closest<HTMLButtonElement>("[data-purge]");
		if (purge) {
			await trashAction(
				{
					action: "purge",
					kind: purge.dataset.kind,
					slug: purge.dataset.slug,
					category: purge.dataset.category,
				},
				"Permanently delete this item? This cannot be undone.",
			);
			return;
		}

		const empty = target.closest<HTMLButtonElement>("[data-empty-trash]");
		if (empty) {
			await trashAction(
				{ action: "empty" },
				"Empty the entire trash permanently? This cannot be undone.",
			);
		}
	});
</script>
