---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { photoCategories } from "../../data/photos";
import { hasWritableMedia, listPhotos } from "../../lib/store";

export const prerender = false;

const photos = await listPhotos();
const writable = hasWritableMedia();

const labels: Record<(typeof photoCategories)[number], string> = {
	architecture: "Architecture",
	"behind-the-scenes": "Behind the scenes",
	"portraits-fashion": "Portraits & fashion",
	"fashion-lookbook": "Fashion lookbook",
	"events-wedding": "Events & wedding",
	"street-photography": "Street",
	"film-portraits-trieste": "Trieste",
};
---

<DashboardLayout title="Photos" section="photos">
	<header class="dash-heading">
		<div>
			<p>Catalog</p>
			<h1>Photos</h1>
		</div>
		<p>
			Drop JPEG, PNG, GIF, BMP, or WebP. They are resized and stored as WebP.
			Rank is not used.
		</p>
	</header>

	{
		!writable && (
			<p class="dash-banner" role="status">
				R2 is not bound on this Worker yet. Uploads need a MEDIA bucket.
			</p>
		)
	}

	<form class="dash-form" data-photo-form>
		<label>
			<span>Category</span>
			<select name="category" required>
				{
					photoCategories.map((category) => (
						<option value={category}>{labels[category]}</option>
					))
				}
			</select>
		</label>
		<label>
			<span>Title</span>
			<input name="title" type="text" placeholder="Optional" />
		</label>
		<label>
			<span>Alt text</span>
			<input name="alt" type="text" placeholder="Optional" />
		</label>
		<label class="dash-form__wide">
			<span>Image</span>
			<input
				name="file"
				type="file"
				required
				accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.png,.webp,.gif,.bmp"
			/>
		</label>
		<button type="submit">Upload photo</button>
		<p class="dash-form__status" data-form-status hidden></p>
	</form>

	{
		photoCategories.map((category) => {
			const items = photos.filter((photo) => photo.category === category);
			return (
				<section class="dash-photos">
					<h2>
						{labels[category]}
						<span>{items.length}</span>
					</h2>
					{items.length === 0 ? (
						<p class="dash-muted">No stills in this category yet.</p>
					) : (
						<ul class="dash-photo-grid">
							{items.map((photo) => (
								<li>
									<img src={photo.src} alt={photo.alt} />
									<div>
										<strong>{photo.title}</strong>
										<button
											type="button"
											class="dash-delete"
											data-delete-photo={photo.slug}
											data-category={photo.category}
										>
											Delete
										</button>
									</div>
								</li>
							))}
						</ul>
					)}
				</section>
			);
		})
	}
</DashboardLayout>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-photo-form]");
	const status = document.querySelector<HTMLElement>("[data-form-status]");

	function setStatus(message: string, isError = false) {
		if (!status) return;
		status.hidden = !message;
		status.textContent = message;
		status.dataset.error = isError ? "true" : "false";
	}

	async function readResponse(response: Response): Promise<{ error?: string }> {
		const text = await response.text();
		if (!text) return {};
		try {
			return JSON.parse(text) as { error?: string };
		} catch {
			return { error: text };
		}
	}

	async function toWebp(file: File) {
		const type = file.type || "";
		if (
			![
				"image/jpeg",
				"image/png",
				"image/webp",
				"image/gif",
				"image/bmp",
			].includes(type) &&
			!/\.(jpe?g|png|webp|gif|bmp)$/i.test(file.name)
		) {
			throw new Error(
				"Use JPEG, PNG, WebP, GIF, or BMP. RAW and HEIC are not converted.",
			);
		}

		const bitmap = await createImageBitmap(file);
		const max = 1600;
		const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
		const width = Math.max(1, Math.round(bitmap.width * scale));
		const height = Math.max(1, Math.round(bitmap.height * scale));
		const canvas = document.createElement("canvas");
		canvas.width = width;
		canvas.height = height;
		const context = canvas.getContext("2d");
		if (!context) throw new Error("Could not convert this image.");
		context.drawImage(bitmap, 0, 0, width, height);
		bitmap.close();

		const blob = await new Promise<Blob | null>((resolve) => {
			canvas.toBlob(resolve, "image/webp", 0.8);
		});
		if (!blob) {
			throw new Error("This browser could not encode WebP. Try a current Chrome or Firefox.");
		}
		return new File([blob], file.name.replace(/\.[^.]+$/, ".webp"), {
			type: "image/webp",
		});
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const input = form.querySelector<HTMLInputElement>('input[name="file"]');
		const file = input?.files?.[0];
		if (!file) return;
		try {
			setStatus("Converting to WebP…");
			const webp = await toWebp(file);
			const payload = new FormData(form);
			payload.set("file", webp);
			setStatus("Uploading…");
			const response = await fetch("/api/photos", {
				method: "POST",
				body: payload,
			});
			const result = await readResponse(response);
			if (!response.ok) {
				setStatus(result.error ?? "Upload failed.", true);
				return;
			}
			location.reload();
		} catch (error) {
			setStatus(
				error instanceof Error ? error.message : "Could not convert image.",
				true,
			);
		}
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
			"[data-delete-photo]",
		);
		if (!button) return;
		const slug = button.dataset.deletePhoto;
		const category = button.dataset.category;
		if (!slug || !category || !confirm("Remove this still?")) return;
		const response = await fetch(
			`/api/photos?slug=${encodeURIComponent(slug)}&category=${encodeURIComponent(category)}`,
			{ method: "DELETE" },
		);
		const result = await readResponse(response);
		if (!response.ok) {
			alert(result.error ?? "Could not delete.");
			return;
		}
		button.closest("li")?.remove();
	});
</script>
