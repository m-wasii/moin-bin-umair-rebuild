---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import {
	hasWritableMedia,
	listPhotoCategories,
	listPhotos,
} from "../../lib/store";

export const prerender = false;

const photos = await listPhotos();
const categories = await listPhotoCategories();
const writable = hasWritableMedia();
---

<DashboardLayout title="Photos" section="photos">
	<header class="dash-heading">
		<div>
			<p>Catalog</p>
			<h1>Photos</h1>
		</div>
		<p>
			Drop JPEG, PNG, GIF, BMP, or WebP. They are resized and stored as WebP.
			Drag ⠿ to reorder photos within an album or whole albums.
		</p>
	</header>

	{
		!writable && (
			<p class="dash-banner" role="status">
				R2 is not bound on this Worker yet. Uploads need a MEDIA bucket.
			</p>
		)
	}

	<form class="dash-form" data-category-form>
		<label class="dash-form__wide">
			<span>New album name</span>
			<input name="label" type="text" required placeholder="e.g. Studio portraits" />
		</label>
		<button type="submit">Add album</button>
		<p class="dash-form__status" data-category-status hidden></p>
	</form>

	<form class="dash-form" data-photo-form>
		<label>
			<span>Category</span>
			<select name="category" required>
				{
					categories.map((category) => (
						<option value={category.slug}>{category.label}</option>
					))
				}
			</select>
		</label>
		<label>
			<span>Title</span>
			<input name="title" type="text" placeholder="Optional" />
		</label>
		<label>
			<span>Alt text</span>
			<input name="alt" type="text" placeholder="Optional" />
		</label>
		<label class="dash-form__wide">
			<span>Image</span>
			<input
				name="file"
				type="file"
				required
				accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.png,.webp,.gif,.bmp"
			/>
		</label>
		<button type="submit">Upload photo</button>
		<p class="dash-form__status" data-form-status hidden></p>
	</form>

	<div data-category-list>
		{
			categories.map((category) => {
				const items = photos.filter((photo) => photo.category === category.slug);
				return (
					<section
						class="dash-photos dash-category"
						data-reorder-item
						data-category={category.slug}
					>
						<div class="dash-category__head">
							<button
								type="button"
								class="dash-handle"
								draggable="true"
								data-drag-handle
								data-category-handle
								aria-label={`Reorder album ${category.label}`}
								title="Drag to reorder album"
							>
								⠿
							</button>
							<h2>
								{category.label}
								<span>{items.length}</span>
							</h2>
						</div>
						{items.length === 0 ? (
							<p class="dash-muted">No stills in this category yet.</p>
						) : (
							<ul class="dash-photo-grid" data-photo-list={category.slug}>
								{items.map((photo) => (
									<li
										class="dash-photo-card"
										data-reorder-item
										data-slug={photo.slug}
									>
										<button
											type="button"
											class="dash-handle dash-handle--photo"
											draggable="true"
											data-drag-handle
											aria-label={`Reorder ${photo.title}`}
											title="Drag to reorder"
										>
											⠿
										</button>
										<img src={photo.src} alt={photo.alt} />
										<div class="dash-photo-card__meta">
											<strong>{photo.title}</strong>
											<button
												type="button"
												class="dash-delete"
												data-delete-photo={photo.slug}
												data-category={photo.category}
											>
												Delete
											</button>
										</div>
									</li>
								))}
							</ul>
						)}
					</section>
				);
			})
		}
	</div>
</DashboardLayout>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-photo-form]");
	const categoryForm = document.querySelector<HTMLFormElement>("[data-category-form]");
	const status = document.querySelector<HTMLElement>("[data-form-status]");
	const categoryStatus = document.querySelector<HTMLElement>("[data-category-status]");
	const categoryList = document.querySelector<HTMLElement>("[data-category-list]");

	function setStatus(
		target: HTMLElement | null,
		message: string,
		isError = false,
	) {
		if (!target) return;
		target.hidden = !message;
		target.textContent = message;
		target.dataset.error = isError ? "true" : "false";
	}

	async function readResponse(response: Response): Promise<{ error?: string }> {
		const text = await response.text();
		if (!text) return {};
		try {
			return JSON.parse(text) as { error?: string };
		} catch {
			return { error: text };
		}
	}

	async function toWebp(file: File) {
		const type = file.type || "";
		if (
			![
				"image/jpeg",
				"image/png",
				"image/webp",
				"image/gif",
				"image/bmp",
			].includes(type) &&
			!/\.(jpe?g|png|webp|gif|bmp)$/i.test(file.name)
		) {
			throw new Error(
				"Use JPEG, PNG, WebP, GIF, or BMP. RAW and HEIC are not converted.",
			);
		}

		const bitmap = await createImageBitmap(file);
		const max = 1600;
		const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
		const width = Math.max(1, Math.round(bitmap.width * scale));
		const height = Math.max(1, Math.round(bitmap.height * scale));
		const canvas = document.createElement("canvas");
		canvas.width = width;
		canvas.height = height;
		const context = canvas.getContext("2d");
		if (!context) throw new Error("Could not convert this image.");
		context.drawImage(bitmap, 0, 0, width, height);
		bitmap.close();

		const blob = await new Promise<Blob | null>((resolve) => {
			canvas.toBlob(resolve, "image/webp", 0.8);
		});
		if (!blob) {
			throw new Error("This browser could not encode WebP. Try a current Chrome or Firefox.");
		}
		return new File([blob], file.name.replace(/\.[^.]+$/, ".webp"), {
			type: "image/webp",
		});
	}

	categoryForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const data = new FormData(categoryForm);
		setStatus(categoryStatus, "Saving…");
		const response = await fetch("/api/photo-categories", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify({ label: String(data.get("label") ?? "") }),
		});
		const result = await readResponse(response);
		if (!response.ok) {
			setStatus(categoryStatus, result.error ?? "Could not save album.", true);
			return;
		}
		location.reload();
	});

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const input = form.querySelector<HTMLInputElement>('input[name="file"]');
		const file = input?.files?.[0];
		if (!file) return;
		try {
			setStatus(status, "Converting to WebP…");
			const webp = await toWebp(file);
			const payload = new FormData(form);
			payload.set("file", webp);
			setStatus(status, "Uploading…");
			const response = await fetch("/api/photos", {
				method: "POST",
				body: payload,
			});
			const result = await readResponse(response);
			if (!response.ok) {
				setStatus(status, result.error ?? "Upload failed.", true);
				return;
			}
			location.reload();
		} catch (error) {
			setStatus(
				status,
				error instanceof Error ? error.message : "Could not convert image.",
				true,
			);
		}
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
			"[data-delete-photo]",
		);
		if (!button) return;
		const slug = button.dataset.deletePhoto;
		const category = button.dataset.category;
		if (!slug || !category || !confirm("Remove this still?")) return;
		const response = await fetch(
			`/api/photos?slug=${encodeURIComponent(slug)}&category=${encodeURIComponent(category)}`,
			{ method: "DELETE" },
		);
		const result = await readResponse(response);
		if (!response.ok) {
			alert(result.error ?? "Could not delete.");
			return;
		}
		button.closest("li")?.remove();
	});

	function setupReorder(
		list: HTMLElement,
		options: {
			handleSelector: string;
			slugFrom: (el: HTMLElement) => string | undefined;
			persist: (slugs: string[]) => Promise<void>;
			axis?: "y" | "xy";
		},
	) {
		let dragEl: HTMLElement | null = null;
		const axis = options.axis ?? "y";

		list.addEventListener("dragstart", (event) => {
			const handle = (event.target as HTMLElement).closest<HTMLElement>(
				options.handleSelector,
			);
			if (!handle || !list.contains(handle)) return;
			const item = handle.closest<HTMLElement>("[data-reorder-item]");
			if (!item || item.parentElement !== list) return;
			dragEl = item;
			item.classList.add("is-dragging");
			event.dataTransfer?.setData("text/plain", options.slugFrom(item) ?? "");
			if (event.dataTransfer) event.dataTransfer.effectAllowed = "move";
		});

		list.addEventListener("dragend", () => {
			dragEl?.classList.remove("is-dragging");
			list
				.querySelectorAll(".is-drop-target")
				.forEach((el) => el.classList.remove("is-drop-target"));
			dragEl = null;
		});

		list.addEventListener("dragover", (event) => {
			if (!dragEl) return;
			event.preventDefault();
			const over = (event.target as HTMLElement).closest<HTMLElement>(
				"[data-reorder-item]",
			);
			if (!over || over === dragEl || over.parentElement !== list) return;

			list
				.querySelectorAll(".is-drop-target")
				.forEach((el) => el.classList.remove("is-drop-target"));
			over.classList.add("is-drop-target");
			const rect = over.getBoundingClientRect();
			const before =
				axis === "xy"
					? event.clientX < rect.left + rect.width / 2
					: event.clientY < rect.top + rect.height / 2;
			if (before) list.insertBefore(dragEl, over);
			else list.insertBefore(dragEl, over.nextSibling);
		});

		list.addEventListener("drop", async (event) => {
			event.preventDefault();
			if (!dragEl) return;
			list
				.querySelectorAll(".is-drop-target")
				.forEach((el) => el.classList.remove("is-drop-target"));
			const slugs = [...list.children]
				.filter((el): el is HTMLElement => el instanceof HTMLElement)
				.map((el) => options.slugFrom(el))
				.filter((slug): slug is string => Boolean(slug));
			try {
				await options.persist(slugs);
			} catch (error) {
				alert(error instanceof Error ? error.message : "Could not reorder.");
				location.reload();
			}
		});
	}

	if (categoryList) {
		setupReorder(categoryList, {
			handleSelector: "[data-category-handle]",
			slugFrom: (el) => el.dataset.category,
			persist: async (slugs) => {
				const response = await fetch("/api/photo-categories", {
					method: "PATCH",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ action: "reorder", slugs }),
				});
				const result = await readResponse(response);
				if (!response.ok) {
					throw new Error(result.error ?? "Could not reorder albums.");
				}
			},
		});
	}

	document.querySelectorAll<HTMLElement>("[data-photo-list]").forEach((list) => {
		const category = list.dataset.photoList;
		if (!category) return;
		setupReorder(list, {
			handleSelector: ".dash-handle--photo",
			slugFrom: (el) => el.dataset.slug,
			axis: "xy",
			persist: async (slugs) => {
				const response = await fetch("/api/photos", {
					method: "PATCH",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ action: "reorder", category, slugs }),
				});
				const result = await readResponse(response);
				if (!response.ok) {
					throw new Error(result.error ?? "Could not reorder photos.");
				}
			},
		});
	});
</script>
