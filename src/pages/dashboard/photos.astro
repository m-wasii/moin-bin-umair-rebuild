---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PageHeader from "../../components/dashboard/PageHeader.astro";
import EmptyState from "../../components/dashboard/EmptyState.astro";
import {
	EMPTY_REVISION,
	type CatalogRevisionMap,
	albumPhotoCounts,
	photosReorderAllowed,
	queryPhotos,
	type PhotosQuery,
	type PhotosSort,
} from "../../lib/dashboard";
import {
	hasWritableMedia,
	readPhotoCategoriesCatalog,
	readPhotosCatalog,
} from "../../lib/store";
import { hostImageSrc } from "../../lib/responsive-image";

export const prerender = false;

function parseAlbum(
	raw: string | null,
	known: Set<string>,
): PhotosQuery["album"] {
	if (!raw || raw === "all") return "all";
	if (known.has(raw)) return raw;
	return "all";
}

function parseSort(raw: string | null): PhotosSort {
	if (raw === "title") return "title";
	return "order";
}

const { photos: catalogPhotos, revision: photosRevision } =
	await readPhotosCatalog();
const { categories, revision: categoriesRevision } =
	await readPhotoCategoriesCatalog();
const writable = hasWritableMedia();
const knownAlbums = new Set(categories.map((entry) => entry.slug));

const initialQuery: PhotosQuery = {
	album: parseAlbum(Astro.url.searchParams.get("album"), knownAlbums),
	q: Astro.url.searchParams.get("q") ?? "",
	sort: parseSort(Astro.url.searchParams.get("sort")),
};

const visiblePhotos = queryPhotos(catalogPhotos, initialQuery);
const reorderAllowed = photosReorderAllowed(initialQuery);
const counts = albumPhotoCounts(catalogPhotos, categories);
const totalCount = catalogPhotos.length;
const resultCount = visiblePhotos.length;
const hasSearch = Boolean((initialQuery.q ?? "").trim());
const selectedAlbum =
	initialQuery.album && initialQuery.album !== "all"
		? categories.find((entry) => entry.slug === initialQuery.album)
		: null;

const revisions: CatalogRevisionMap = {
	videos: { ...EMPTY_REVISION },
	photos: photosRevision,
	photoCategories: categoriesRevision,
	shorts: { ...EMPTY_REVISION },
	hero: { ...EMPTY_REVISION },
};

const bootstrap = {
	photos: catalogPhotos,
	categories,
	writable,
};

function thumbSrc(src: string) {
	return hostImageSrc(src, 400);
}

function thumbSrcSet(src: string) {
	return `${hostImageSrc(src, 400)} 400w, ${hostImageSrc(src, 600)} 600w`;
}
---

<DashboardLayout
	title="Photography"
	section="photography"
	revisions={revisions}
	statusLabel={writable ? "Storage ready" : "Storage unavailable"}
	statusTone={writable ? "neutral" : "danger"}
	breadcrumbs={selectedAlbum ? [{ label: selectedAlbum.label }] : []}
>
	<div class="dash-photo" data-photo-workspace>
		<PageHeader
			eyebrow="Media"
			title="Photography"
			description={`${totalCount} photo${totalCount === 1 ? "" : "s"} across ${categories.length} album${categories.length === 1 ? "" : "s"}. Browse by album, inspect, and publish safely.`}
		>
			<div slot="actions">
				<button
					type="button"
					class="dash-btn dash-btn--ghost"
					data-photo-new-album
					disabled={!writable}
				>
					New album
				</button>
				<button
					type="button"
					class="dash-btn dash-btn--primary"
					data-photo-upload
					disabled={!writable}
				>
					Upload
				</button>
			</div>
		</PageHeader>

		{
			!writable && (
				<p class="dash-banner" role="status">
					R2 is not bound on this Worker yet. Uploads need a MEDIA bucket.
				</p>
			)
		}

		<div class="dash-photo-layout">
			<aside class="dash-photo-rail" aria-label="Albums">
				<div class="dash-photo-rail__head">
					<h2 class="dash-photo-rail__title">Albums</h2>
					<p class="dash-photo-rail__hint" data-album-reorder-hint hidden={!writable}>
						Drag or use ↑↓ to reorder
					</p>
				</div>
				<ul class="dash-photo-rail__list" data-album-list role="list">
					<li>
						<button
							type="button"
							class="dash-photo-rail__item"
							data-album="all"
							data-active={initialQuery.album === "all" ? "true" : undefined}
							aria-current={initialQuery.album === "all" ? "true" : undefined}
						>
							<span class="dash-photo-rail__name">All photos</span>
							<span class="dash-photo-rail__count">{totalCount}</span>
						</button>
					</li>
					{
						categories.map((category, index) => {
							const count = counts.get(category.slug) ?? 0;
							const isActive = initialQuery.album === category.slug;
							return (
								<li
									class="dash-photo-rail__row"
									data-reorder-item
									data-category={category.slug}
								>
									<button
										type="button"
										class="dash-handle dash-photo-rail__handle"
										draggable={writable ? "true" : undefined}
										data-drag-handle
										data-category-handle
										aria-label={`Reorder album ${category.label}`}
										title="Drag to reorder album"
										disabled={!writable}
									>
										⠿
									</button>
									<button
										type="button"
										class="dash-photo-rail__item"
										data-album={category.slug}
										data-active={isActive ? "true" : undefined}
										aria-current={isActive ? "true" : undefined}
									>
										<span class="dash-photo-rail__name">{category.label}</span>
										<span class="dash-photo-rail__count">{count}</span>
									</button>
									<div class="dash-photo-rail__moves">
										<button
											type="button"
											class="dash-photo-rail__move"
											data-album-reorder="up"
											disabled={!writable || index === 0}
											aria-label={`Move ${category.label} up`}
										>
											↑
										</button>
										<button
											type="button"
											class="dash-photo-rail__move"
											data-album-reorder="down"
											disabled={!writable || index === categories.length - 1}
											aria-label={`Move ${category.label} down`}
										>
											↓
										</button>
									</div>
								</li>
							);
						})
					}
				</ul>
			</aside>

			<section class="dash-photo-main" aria-label="Photos">
				<div class="dash-photo-toolbar">
					<div class="dash-photo-toolbar__row">
						<label class="dash-photo-toolbar__search">
							<span class="visually-hidden">Search photos</span>
							<input
								type="search"
								placeholder="Search title, alt, slug…"
								value={initialQuery.q ?? ""}
								data-photo-search
								autocomplete="off"
							/>
						</label>
						<label class="dash-photo-toolbar__sort">
							<span class="visually-hidden">Sort</span>
							<select data-photo-sort>
								<option value="order" selected={initialQuery.sort === "order"}>
									Album order
								</option>
								<option value="title" selected={initialQuery.sort === "title"}>
									Title
								</option>
							</select>
						</label>
						<p class="dash-photo-toolbar__count" data-photo-count>
							{
								hasSearch || selectedAlbum
									? `${resultCount} of ${selectedAlbum ? (counts.get(selectedAlbum.slug) ?? 0) : totalCount}`
									: `${resultCount} photo${resultCount === 1 ? "" : "s"}`
							}
						</p>
						<div class="dash-photo-toolbar__album-actions" data-album-actions hidden={!selectedAlbum || !writable}>
							<button
								type="button"
								class="dash-btn dash-btn--ghost"
								data-album-rename
							>
								Rename album
							</button>
							<button
								type="button"
								class="dash-btn dash-btn--ghost"
								data-album-delete
							>
								Delete album
							</button>
						</div>
					</div>
					{
						!reorderAllowed && (
							<p class="dash-photo-helper" data-photo-reorder-hint>
								Reordering photos is available when viewing one album in album
								order with no search.
							</p>
						)
					}
					{
						reorderAllowed && (
							<p class="dash-photo-helper" data-photo-reorder-hint hidden>
								Reordering photos is available when viewing one album in album
								order with no search.
							</p>
						)
					}
				</div>

				<div class="dash-photo-mobile-album">
					<label>
						<span class="visually-hidden">Album</span>
						<select data-photo-album-select>
							<option value="all" selected={initialQuery.album === "all"}>
								All photos ({totalCount})
							</option>
							{
								categories.map((category) => (
									<option
										value={category.slug}
										selected={initialQuery.album === category.slug}
									>
										{category.label} ({counts.get(category.slug) ?? 0})
									</option>
								))
							}
						</select>
					</label>
				</div>

				<div class="dash-photo-content" data-photo-content>
					{
						categories.length === 0 ? (
							<EmptyState
								title="No albums yet"
								detail="Create an album before uploading photos."
							>
								<button
									type="button"
									class="dash-btn dash-btn--primary"
									data-photo-new-album
									disabled={!writable}
								>
									New album
								</button>
							</EmptyState>
						) : totalCount === 0 ? (
							<EmptyState
								title="No photos yet"
								detail="Upload stills into an album. JPEG, PNG, GIF, BMP, or WebP convert to WebP automatically."
							>
								<button
									type="button"
									class="dash-btn dash-btn--primary"
									data-photo-upload
									disabled={!writable}
								>
									Upload photos
								</button>
							</EmptyState>
						) : visiblePhotos.length === 0 && hasSearch ? (
							<EmptyState
								title="Nothing found"
								detail="No photos match this search. Clear search to see the album again."
							>
								<button
									type="button"
									class="dash-btn dash-btn--ghost"
									data-photo-clear-search
								>
									Clear search
								</button>
							</EmptyState>
						) : visiblePhotos.length === 0 && selectedAlbum ? (
							<EmptyState
								title="Empty album"
								detail={`${selectedAlbum.label} has no photos yet.`}
							>
								<button
									type="button"
									class="dash-btn dash-btn--primary"
									data-photo-upload
									disabled={!writable}
								>
									Upload to this album
								</button>
							</EmptyState>
						) : (
							<ul
								class="dash-photo-grid"
								data-photo-grid
								role="list"
								aria-label="Photo grid"
							>
								{visiblePhotos.map((photo, index) => (
									<li
										class="dash-photo-tile"
										data-reorder-item={reorderAllowed ? "" : undefined}
										data-slug={photo.slug}
										data-category={photo.category}
										data-photo-key={`${photo.category}/${photo.slug}`}
									>
										<button
											type="button"
											class="dash-photo-tile__hit"
											data-photo-open
											aria-label={`Inspect ${photo.title}`}
										>
											<img
												src={thumbSrc(photo.src)}
												srcset={thumbSrcSet(photo.src)}
												sizes="(max-width: 767px) 42vw, 160px"
												alt={photo.alt}
												width="400"
												height="400"
												loading={index < 12 ? "eager" : "lazy"}
												decoding="async"
											/>
										</button>
										<div class="dash-photo-tile__meta">
											<span class="dash-photo-tile__title">{photo.title}</span>
											{reorderAllowed && (
												<div class="dash-photo-tile__reorder">
													<button
														type="button"
														class="dash-handle dash-photo-tile__handle"
														draggable="true"
														data-drag-handle
														aria-label={`Reorder ${photo.title}`}
														title="Drag to reorder"
													>
														⠿
													</button>
													<button
														type="button"
														class="dash-photo-tile__move"
														data-photo-reorder="up"
														disabled={index === 0}
														aria-label={`Move ${photo.title} earlier`}
													>
														↑
													</button>
													<button
														type="button"
														class="dash-photo-tile__move"
														data-photo-reorder="down"
														disabled={index === visiblePhotos.length - 1}
														aria-label={`Move ${photo.title} later`}
													>
														↓
													</button>
												</div>
											)}
										</div>
									</li>
								))}
							</ul>
						)
					}
				</div>
			</section>

			<aside
				class="dash-photo-inspector"
				data-photo-inspector
				aria-label="Photo inspector"
			>
				<div class="dash-photo-inspector__empty" data-inspector-empty>
					<p class="dash-photo-inspector__empty-title">Select a photo</p>
					<p class="dash-photo-inspector__empty-copy">
						Preview, edit title and alt text, replace the asset, or delete —
						without leaving the album.
					</p>
				</div>
				<div class="dash-photo-inspector__body" data-inspector-body hidden></div>
			</aside>
		</div>

		<div
			class="dash-photo-live visually-hidden"
			data-photo-live
			aria-live="polite"
			aria-atomic="true"
		>
		</div>

		<noscript>
			<p class="dash-photo-helper">
				JavaScript is required to upload, edit, reorder, or delete photos. This
				view is read-only without scripting.
			</p>
		</noscript>
	</div>

	<script
		is:inline
		type="application/json"
		id="dash-photo-bootstrap"
		set:html={JSON.stringify(bootstrap)}
	/>
	<script is:inline src="/dashboard/photography-workspace.js"></script>
</DashboardLayout>

<style is:global>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
