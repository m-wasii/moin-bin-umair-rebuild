{
	// Experiment / engagement preview Worker — does NOT replace production `mbu`.
	// Deploy: npm run deploy:eng
	// URL:    https://mbu-eng.wasi-workdesk.workers.dev
	"name": "mbu-eng",
	"compatibility_date": "2025-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	// Same MEDIA → moin-media binding as production so photos/shorts resolve.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "moin-media",
		},
	],
}
