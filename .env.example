# Public site URL (canonical / Open Graph) — not a secret
SITE=https://moinbinumair.com

# Dashboard host (Google login via Cloudflare Access) — not a secret
PUBLIC_DASHBOARD_URL=https://dashboard.moinbinumair.com

# Access enforcement defaults ON. To disable for insecure bring-up ONLY, set BOTH:
#   DASHBOARD_ENFORCE_CF_ACCESS=false
#   ALLOW_INSECURE_DASHBOARD_BRINGUP=true
# A lone DASHBOARD_ENFORCE_CF_ACCESS=false is ignored (still enforced).
# Production should omit both (or set DASHBOARD_ENFORCE_CF_ACCESS=true).
# DASHBOARD_ENFORCE_CF_ACCESS=true
# ALLOW_INSECURE_DASHBOARD_BRINGUP=

# Server-only: Cloudflare Access JWT verification (required when Access is enforced)
# Team domain from Zero Trust → Settings → Custom Pages URL host, e.g. myteam.cloudflareaccess.com
# CF_ACCESS_TEAM_DOMAIN=
# Application AUD tag from the Access application for dashboard.<domain>
# CF_ACCESS_AUD=

# Server-only: shared secret for POST /cdn-purge (set on both mbu and dashboard Workers)
# Generate a long random value; never use PUBLIC_* for this.
# Never bake into client bundles; CI uses the repository/environment secret of the same name.
# CDN_PURGE_SECRET=

# Server-only: optional YouTube Data API key for auto duration (never PUBLIC_*)
# YOUTUBE_API_KEY=

# --- Script target safety (local / CI operators) ---
# Destructive or remote scripts require an explicit --target:
#   development  seed:photos / seed:shorts (local .data only)
#   preview      seed:r2 / verify:shorts-r2 / purge against a PR Worker (--origin required)
#   production   seed:r2 / migrate / purge (also requires --i-know-this-is-production)
